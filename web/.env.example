# Backend origin used by Next.js runtime proxy and server-side fetches.
BIODAYS_API_URL=http://127.0.0.1:8080
# Public site origin, used for metadata, sitemap and robots.
BIODAYS_SITE_URL=http://localhost:3000
# Public Swagger UI address linked from /about.
NEXT_PUBLIC_BIODAYS_DOCS_URL=http://127.0.0.1:8080/swagger/index.html
