{
  "name": "biodays-web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node scripts/check-node.mjs && bun run prepare:assets && next dev",
    "build": "node scripts/check-node.mjs && bun run prepare:assets && next build",
    "start": "node scripts/check-node.mjs && next start",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "typecheck": "tsc --noEmit",
    "prepare:assets": "bun run content:check && bun scripts/prepare-assets.mjs",
    "content:check": "bun scripts/content.mjs && bun scripts/lab-content.mjs",
    "test": "bun test tests --timeout 20000",
    "test:e2e": "playwright test",
    "test:admin:create": "bun scripts/create-test-admin.ts"
  },
  "dependencies": {
    "@neodrag/react": "^2.3.1",
    "@react95/core": "^10.0.6",
    "@react95/icons": "^2.8.0",
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.118.0",
    "@tanstack/react-query": "^5.104.5",
    "ai": "7.0.154",
    "cn": "^0.5.0",
    "gray-matter": "4.0.3",
    "katex": "^0.19.0",
    "next": "16.4.2",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-markdown": "^10.1.0",
    "rehype-katex": "^7.0.1",
    "remark-cjk-friendly": "^2.3.3",
    "remark-math": "^6.0.0",
    "resend": "6.34.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.2",
    "@playwright/test": "1.64.1",
    "@tailwindcss/turbopack": "^4",
    "@types/bun": "1.3.11",
    "@types/node": "24.19.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "subset-font": "^2.9.0",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "packageManager": "bun@1.4.4",
  "ignoreScripts": [
    "sharp",
    "unrs-resolver"
  ],
  "trustedDependencies": [
    "sharp",
    "unrs-resolver"
  ],
  "overrides": {
    "katex": "0.19.0"
  },
  "engines": {
    "node": "24.x"
  }
}
