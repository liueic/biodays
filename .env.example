# Image produced by the GitHub Actions container workflow.
BIODAYS_IMAGE=docker.cnb.cool/ciallo.cv/biodays:latest

# Host port mapped to the container's single exposed port (3000).
BIODAYS_HTTP_PORT=8080

# Public origin used in canonical URLs, sitemap and robots.
# Use your server IP/domain and the port above.
BIODAYS_SITE_URL=http://localhost:8080

# Per-client requests per minute.
BIODAYS_RATE_LIMIT=60
BIODAYS_LOG_LEVEL=info

# Host directory containing stories_q1.json / stories_q4.json.
# Mounted read-only at /seed and imported automatically on every container start.
BIODAYS_DATA_DIR=/srv/biodays/data
