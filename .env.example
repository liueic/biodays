# Public URL used by canonical links and email links. Use each preview's own URL.
BIODAYS_SITE_URL=http://localhost:3000
# Server only: never prefix the secret key with NEXT_PUBLIC_.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
BIODAYS_FEEDBACK_ENABLED=true
# Bootstrap defaults. After first request, runtime settings in Supabase take precedence.
RESEND_ENABLED=false
RESEND_API_KEY=
RESEND_FROM=
BIODAYS_NOTIFY_TO=
# Server-only fallback for Jev. Enable review in admin settings after configuration.
AI_GATEWAY_API_KEY=
# 32 random bytes, base64 or 64 hex characters; keep stable and backed up.
BIODAYS_SETTINGS_ENC_KEY=
# Shared with Supabase Vault. Generate separately from the encryption key.
BIODAYS_CRON_SECRET=
RESEND_WEBHOOK_SECRET=
# Preview fails closed without a recipient allowlist. Separate addresses with commas.
BIODAYS_MAIL_ALLOWLIST=
NEXT_PUBLIC_BIODAYS_DOCS_URL=/swagger/index.html
# Disable analytics for local testing. Existing production analytics remain on public reading pages.
BIODAYS_DISABLE_ANALYTICS=false
