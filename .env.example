# biodays 部署环境变量
# 复制为 .env 后填写；.env 已被 .gitignore 忽略，不要把真实凭据提交到仓库。
#   cp .env.example .env
#   docker compose pull && docker compose up -d
#
# 传递方式：docker-compose.yml 通过 env_file 把这里的 BIODAYS_* 变量原样
# 传入容器——含 $ 的 bcrypt 哈希、SMTP 授权码不需要 $$ 转义，直接写即可。

# ── 镜像与访问 ───────────────────────────────────────────────────────
# CNB 流水线构建的镜像；生产建议固定到 tag 或 digest，而不是长期使用 latest。
BIODAYS_IMAGE=docker.cnb.cool/ciallo.cv/biodays:latest
# missing 仅在本机缺失时拉取；always 每次启动都对齐远端。
BIODAYS_PULL_POLICY=missing
# 宿主机映射到容器内唯一端口（容器内 Next.js 监听 3000）。
BIODAYS_HTTP_PORT=8080
# Caddy 在宿主机时仅监听回环，避免外部绕过 Caddy 伪造转发头。
# 需要从其他机器直接访问时可设为 0.0.0.0，并用防火墙限制入口。
BIODAYS_BIND_IP=127.0.0.1

# ── 数据库（PostgreSQL，必填）────────────────────────────────────────
# 应用容器通过 BIODAYS_DB_DSN 连接 compose 里的 db 服务；故事与反馈同库。
# 用 hex 随机串避免 DSN 里的 URL 转义问题：
#   openssl rand -hex 24
BIODAYS_POSTGRES_PASSWORD=
# 数据库备份使用 pg_dump（应用容器内 biodays backup 仅支持 SQLite 模式）：
#   docker compose exec db pg_dump -U biodays biodays > backup.sql

# ── 站点、限流与日志 ─────────────────────────────────────────────────
# 浏览器实际访问的公网 origin（scheme + host + port，不要带路径/查询/结尾斜杠）。
# canonical、sitemap、robots、确认/退订链接和管理端 Origin 校验都使用它。
BIODAYS_SITE_URL=http://localhost:8080
# 公开 API 的 CORS 允许来源，多个用逗号分隔；站点自身 origin 会自动加入。
# 默认 * 与镜像既有行为一致；只服务本站和已知客户端时建议改成明确列表。
BIODAYS_CORS_ORIGINS=*
# 单客户端每分钟请求数。
BIODAYS_RATE_LIMIT=60
BIODAYS_LOG_LEVEL=info
# 容器内 Next.js 与 Go 同机；如经独立反代容器接入，追加其 IP/CIDR。
BIODAYS_TRUSTED_PROXIES=127.0.0.1,::1
# 正式环境保持 release；debug 仅用于本地排查。
GIN_MODE=release

# 故事 JSON 在构建时导入镜像内 SQLite（镜像内 /data/biodays.db），无需数据挂载。

# ── 匿名反馈与管理员后台（默认关闭）──────────────────────────────────
# 启用前先生成管理员密码哈希（密码不进入命令参数或镜像）：
#   cd server && go run ./cmd/biodays hash-password
# 容器内：
#   docker compose run --rm --entrypoint /usr/local/bin/biodays app hash-password
BIODAYS_FEEDBACK_ENABLED=false
# 启用反馈时以下三项必填，否则 Go 服务启动时直接报配置错误。
BIODAYS_ADMIN_USERNAME=
# 把上一行替换为（保留单引号）：
#   BIODAYS_ADMIN_PASSWORD_HASH='$2a$12$...'
BIODAYS_ADMIN_PASSWORD_HASH=''
BIODAYS_ADMIN_SESSION_TTL=8h
# 至少 32 字节随机密钥，用于 IP/邮箱 HMAC 限流键与令牌指纹；
# 部署后不要更换，否则现有会话和令牌会失效。
#   openssl rand -base64 48
BIODAYS_ABUSE_KEY_SECRET=''
# 管理端故事发布的静态 Bearer Token（可选）。设置后可用脚本/CI 直接发布：
#   python3 scripts/stories.py publish --api https://your-domain --token <token>
# 等同发布权限，至少 32 字节随机值（openssl rand -hex 32），只放服务端/CI secret。
BIODAYS_ADMIN_API_TOKEN=

# 订阅需要 SMTP 同时启用；关闭 SMTP 时反馈仍可提交，邮件任务保留在队列。
BIODAYS_FEEDBACK_SUBSCRIPTIONS_ENABLED=true
# 每 IP 投稿频控（小时 / 天）。
BIODAYS_FEEDBACK_SUBMIT_HOURLY=5
BIODAYS_FEEDBACK_SUBMIT_DAILY=20
# 每收件人确认邮件频控（小时 / 天）。
BIODAYS_FEEDBACK_RESEND_HOURLY=3
BIODAYS_FEEDBACK_RESEND_DAILY=10

# ── 反垃圾：PoW / Turnstile / Workers AI（可选）──────────────────────
# 首次确认邮件按收件邮箱 + 全局双重限额；重发另受 RESEND 额度和全局日额度约束。
BIODAYS_FEEDBACK_CONFIRM_HOURLY=1
BIODAYS_FEEDBACK_CONFIRM_DAILY=3
BIODAYS_FEEDBACK_CONFIRM_DAILY_GLOBAL=100
# 管理员新反馈邮件每小时上限；超出后不再逐条发信，后台收件箱仍可查看。
BIODAYS_FEEDBACK_ADMIN_MAIL_HOURLY=10

# 自托管 SHA-256 工作量证明。大陆访客的主验证路径，默认开启。
BIODAYS_FEEDBACK_POW_ENABLED=true
# 前导十六进制零个数 3–5；4 约几十万次哈希，现代浏览器通常 <1 秒。
BIODAYS_FEEDBACK_POW_DIFFICULTY=4
BIODAYS_FEEDBACK_POW_TTL=10m
# 打开页面后至少等待多少秒才能提交，防止立即脚本提交。
BIODAYS_FEEDBACK_POW_MIN_SECONDS=3

# Turnstile 官方不支持中国大陆；大陆入口请保持关闭，PoW 已覆盖。
# 仅在海外入口或 CDN 可用时开启，前端 8 秒加载失败会自动回退 PoW。
BIODAYS_FEEDBACK_TURNSTILE_ENABLED=false
BIODAYS_TURNSTILE_SITE_KEY=
# 仅运行时注入，绝不写入前端或镜像。
BIODAYS_TURNSTILE_SECRET_KEY=''
# 逗号分隔；留空时使用 BIODAYS_SITE_URL 的 host。
BIODAYS_TURNSTILE_HOSTNAMES=
BIODAYS_TURNSTILE_TIMEOUT=3s

# 规则评分与自动隔离总开关。0–29 正常，30–69 待复核，70–100 自动隔离。
BIODAYS_FEEDBACK_SPAM_ENABLED=true
BIODAYS_FEEDBACK_SPAM_REVIEW_SCORE=30
BIODAYS_FEEDBACK_SPAM_BLOCK_SCORE=70

# Workers AI 复核默认关闭。开启后仅把“待复核”投稿的去标识标题/正文
# 发给 Cloudflare Workers AI；不发送邮箱、昵称、IP 或链接参数。
BIODAYS_AI_SPAM_ENABLED=false
BIODAYS_CF_ACCOUNT_ID=
# 仅运行时注入。
BIODAYS_CF_API_TOKEN=''
# 默认 Clef-Flash（decision 请求形态，适合分类，按输入计费）。
# 切到 Qwen/GLM/Llama 等聊天模型时，同时把 STYLE 改为 chat。
BIODAYS_AI_SPAM_MODEL='@cf/cloudflare/clef-flash'
BIODAYS_AI_SPAM_STYLE=decision
BIODAYS_AI_SPAM_TIMEOUT=2s
BIODAYS_AI_SPAM_THRESHOLD=0.8
# UTC 日窗口；每次 AI 调用消耗一个额度，耗尽后只用规则判断。
BIODAYS_AI_SPAM_DAILY_LIMIT=500
BIODAYS_AI_SPAM_MAX_CHARS=4000

# 反馈库由镜像/compose 固定在 /var/lib/biodays/feedback.db，并挂载命名卷；
# 重新创建容器不会丢失反馈。本地 go run 默认使用 ./feedback.db。

# ── SMTP（默认关闭）─────────────────────────────────────────────────
# 关闭时后台显示“邮件发送暂停”，投稿仍保存并保留管理员通知任务；
# 订阅选项不展示，服务端拒绝新的 subscribe_updates=true 请求。
BIODAYS_SMTP_ENABLED=false
BIODAYS_SMTP_HOST=
# starttls 通常配 587，implicit_tls 通常配 465；不允许明文降级。
BIODAYS_SMTP_PORT=587
BIODAYS_SMTP_TLS_MODE=starttls
BIODAYS_SMTP_USERNAME=
# 授权码/密码可能含 $，必须保留单引号，例如 BIODAYS_SMTP_PASSWORD='p$ss'
BIODAYS_SMTP_PASSWORD=''
# 站点固定发件地址；所有邮件都使用它，绝不使用用户邮箱作为 From。
BIODAYS_SMTP_FROM=
# 管理员新反馈通知与测试邮件的唯一收件地址。
BIODAYS_FEEDBACK_NOTIFY_TO=
# 连接与协议读写超时。
BIODAYS_SMTP_TIMEOUT=10s

# ── 由镜像内部固定、通常无需设置 ─────────────────────────────────────
# BIODAYS_PORT=8080
# BIODAYS_DB_PATH=/data/biodays.db
# BIODAYS_FEEDBACK_DB_PATH=/var/lib/biodays/feedback.db
# BIODAYS_API_URL=http://127.0.0.1:8080
# 本地直接运行 Go 服务时，才需要自行设置 DB_PATH / FEEDBACK_DB_PATH / DATA_DIR。
