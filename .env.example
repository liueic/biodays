# Biodays — deployment configuration only.
# Vercel Root Directory: web. Set variables separately for Production / Preview.
# Local: cd web && cp .env.example .env.local, then fill in values and restart.
# Vercel changes require a new deployment; admin displays these values read-only.
# Keep real secrets out of Git and never add NEXT_PUBLIC_ to server credentials.

# Site origin, also used for CSRF and email links. No trailing path.
# On Vercel Preview, leave empty to use that deployment's VERCEL_URL automatically.
BIODAYS_SITE_URL=http://localhost:3000
BIODAYS_FEEDBACK_ENABLED=true

# Supabase — use a separate project for Production and Preview/local development.
# Publishable/anon key for server-side Auth; secret/service_role key for the backend.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# Resend — configure the verified sender and the administrator's notification inbox.
# After configuring these, enable sending in /admin/settings (off by default).
# Example RESEND_FROM: "Biodays <hello@example.com>"
RESEND_API_KEY=
RESEND_FROM=
BIODAYS_NOTIFY_TO=
RESEND_WEBHOOK_SECRET=
# Shared with Supabase Vault; generate a separate random value: openssl rand -hex 32
BIODAYS_CRON_SECRET=
# Comma-separated test inboxes. Preview blocks ALL mail when this is empty.
BIODAYS_MAIL_ALLOWLIST=

# Jev via Vercel AI Gateway — only key source; enable AI review in admin afterwards.
AI_GATEWAY_API_KEY=

# Cloudflare Turnstile — optional. Configure all three before enabling it in admin.
# Hostnames only, comma-separated; no protocol, path or port.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
TURNSTILE_HOSTNAMES=

# Public docs link (NEXT_PUBLIC_ values are bundled at build time).
NEXT_PUBLIC_BIODAYS_DOCS_URL=/swagger/index.html
# Keep true for local testing; set false for production analytics if desired.
BIODAYS_DISABLE_ANALYTICS=true

# Administrator bootstrap only: temporarily set these when running bun run admin:create.
# Remove the password from your environment after creating the account.
# BIODAYS_ADMIN_EMAIL=
# BIODAYS_ADMIN_PASSWORD=

# Feature switches, models, thresholds, limits and timeouts are managed in admin.
# RESEND_ENABLED and BIODAYS_SETTINGS_ENC_KEY are obsolete and no longer read.
