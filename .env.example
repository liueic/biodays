# 由 CNB 流水线（.cnb.yml 的 container 流水线）推送的镜像。
# 也可固定到具体 tag / digest，生产环境不建议长期用 latest：
#   docker.cnb.cool/ciallo.cv/biodays:sha-<短哈希>
BIODAYS_IMAGE=docker.cnb.cool/ciallo.cv/biodays:latest

# compose 拉镜像策略：missing 仅在本地缺失时拉取，always 每次启动都对齐远端。
BIODAYS_PULL_POLICY=missing

# 宿主机映射到容器内唯一端口（3000）。
BIODAYS_HTTP_PORT=8080
# Caddy 在宿主机时仅监听回环，避免外部绕过 Caddy 伪造转发头。
# 需要从其他机器直接访问时可设为 0.0.0.0，并用防火墙限制入口。
BIODAYS_BIND_IP=127.0.0.1

# canonical / sitemap / robots 使用的公网地址，填用户实际访问的地址和端口。
BIODAYS_SITE_URL=http://localhost:8080

# 单客户端每分钟请求数。
BIODAYS_RATE_LIMIT=60
BIODAYS_LOG_LEVEL=info
# Next.js 与 Go 在同一容器时信任回环即可，自动读取 X-Forwarded-For / X-Real-IP。
# Caddy 直接连接独立 Go 容器时，追加 Caddy 的实际 IP/CIDR。
BIODAYS_TRUSTED_PROXIES=127.0.0.1,::1

# Gin 运行模式。正式环境保持 release，debug 只会在本地排查问题时开。
GIN_MODE=release

# 故事数据由仓库 data/stories_*.json 在构建时导入镜像内 SQLite，无需数据挂载。
